{
  "name": "copilot-mem-ext",
  "publisher": "akashdwivedi",
  "repository": {"type": "git", "url": "https://github.com/akashdwivedi/copilot-mem-ext.git"},
  "displayName": "Copilot Mem",
  "description": "Persistent memory for GitHub Copilot inside VS Code",
  "version": "1.2.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Machine Learning"
  ],
  "main": "./dist/extension.js",
  "activationEvents": ["*"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilot-mem-sidebar",
          "title": "Copilot Mem",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "copilot-mem-sidebar": [
        {
          "id": "copilot-mem-explorer",
          "name": "Stored Memories"
        }
      ]
    },
    "commands": [
      {
        "command": "copilot-mem.refresh",
        "title": "Refresh Memories",
        "icon": "$(refresh)"
      },
      {
        "command": "copilot-mem.delete",
        "title": "Delete Memory",
        "icon": "$(trash)"
      },
      {
        "command": "copilot-mem.enableAutoCapture",
        "title": "Copilot Mem: Enable Auto-Capture (Hooks)"
      },
      {
        "command": "copilot-mem.disableAutoCapture",
        "title": "Copilot Mem: Disable Auto-Capture (Hooks)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "copilot-mem.refresh",
          "when": "view == copilot-mem-explorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "copilot-mem.delete",
          "when": "view == copilot-mem-explorer",
          "group": "inline"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "copilot_mem_search",
        "displayName": "Search Memory",
        "userDescription": "Search Copilot's persistent memory store.",
        "canBeReferencedInPrompt": true,
        "tags": ["memory", "context", "history"],
        "toolReferenceName": "searchMem",
        "icon": "$(search)",
        "description": "Search the persistent memory store.",
        "modelDescription": "Search the persistent memory store for previously saved context, preferences, or facts.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Keywords or phrase to search for." }
          },
          "required": ["query"]
        }
      },
      {
        "name": "copilot_mem_save",
        "displayName": "Save Memory",
        "userDescription": "Save context to Copilot's persistent memory.",
        "canBeReferencedInPrompt": true,
        "tags": ["memory", "remember"],
        "toolReferenceName": "saveMem",
        "icon": "$(save)",
        "description": "Save important context to memory.",
        "modelDescription": "Persist a fact, preference, or piece of context so it can be recalled in future chat sessions.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "content": { "type": "string", "description": "The information to remember." }
          },
          "required": ["content"]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "20.x",
    "typescript": "^5.4.5",
    "esbuild": "^0.21.5",
    "@vscode/vsce": "^2.31.1"
  }
}
