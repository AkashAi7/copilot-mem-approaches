{
  "name": "memory-lane",
  "publisher": "akashdwivedi",
  "repository": {"type": "git", "url": "https://github.com/AkashAi7/copilot-mem-approaches.git"},
  "displayName": "Memory Lane",
  "description": "Persistent memory lane for GitHub Copilot chat.",
  "version": "1.3.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Machine Learning"
  ],
  "main": "./dist/extension.js",
  "activationEvents": ["*"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "memory-lane-sidebar",
          "title": "Memory Lane",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "memory-lane-sidebar": [
        {
          "id": "memory-lane-explorer",
          "name": "Stored Memories"
        }
      ]
    },
    "commands": [
      {
        "command": "memory-lane.refresh",
        "title": "Refresh Memories",
        "icon": "$(refresh)"
      },
      {
        "command": "memory-lane.delete",
        "title": "Delete Memory",
        "icon": "$(trash)"
      },
      {
        "command": "memory-lane.enableAutoCapture",
        "title": "Memory Lane: Enable Auto-Capture (Hooks)"
      },
      {
        "command": "memory-lane.disableAutoCapture",
        "title": "Memory Lane: Disable Auto-Capture (Hooks)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "memory-lane.refresh",
          "when": "view == memory-lane-explorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "memory-lane.delete",
          "when": "view == memory-lane-explorer",
          "group": "inline"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "lane_search",
        "displayName": "Search Memory Lane",
        "userDescription": "Search persistent Memory Lane storage.",
        "canBeReferencedInPrompt": true,
        "tags": ["memory", "context", "history"],
        "toolReferenceName": "laneSearch",
        "icon": "$(search)",
        "description": "Search the Memory Lane store.",
        "modelDescription": "Search the Memory Lane store for previously saved context, preferences, or facts.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Keywords or phrase to search for." }
          },
          "required": ["query"]
        }
      },
      {
        "name": "lane_save",
        "displayName": "Save to Memory Lane",
        "userDescription": "Save context to Memory Lane.",
        "canBeReferencedInPrompt": true,
        "tags": ["memory", "remember"],
        "toolReferenceName": "laneSave",
        "icon": "$(save)",
        "description": "Save important context to Memory Lane.",
        "modelDescription": "Persist a fact, preference, or piece of context to Memory Lane so it can be recalled in future chat sessions.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "content": { "type": "string", "description": "The information to remember." }
          },
          "required": ["content"]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "20.x",
    "typescript": "^5.4.5",
    "esbuild": "^0.21.5",
    "@vscode/vsce": "^2.31.1"
  }
}
